    },
    {
      "id": "xy2Onsi6EgTof-xPAHF9W",
      "type": "text",
      "x": -4741.34312755427,
      "y": 71.24187250532896,
      "width": 800,
      "height": 625,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "dashed",
      "roughness": 2,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b1p",
      "roundness": null,
      "seed": 1767883914,
      "version": 682,
      "versionNonce": 1855194774,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1791355494604,
      "created": 1791353568147,
      "link": null,
      "locked": false,
      "text": "Проверка токена: 10мс\nЧтение водителей и выбор кандидата: 150мс\nТранзакция: 20мс\nУведомление: 200мс\nФормирование ответа: 5мс\n\nИтого: 10 + 150 + 20 + 200 + 5 = 385мс ~ 400мс\n\nЕсли 'уведомление' от водителя не пришло за 500мс, то итог: 400мс - 200мс +\n500мс = 700мс\n\n----\n\nТребование про подбор за 3 секунды относится ко времени от заказа пассажира\nдо выбора кандидата. В этот бюджет входят передача запроса, ожидание начала\nобработки, проверка токена, чтение водителей и подбор. Если передача запроса\nзанимает 50 мс, разбор и проверка токена 5 мс, а чтение и подбор 150 мс, на\nожидание начала обработки остаётся 3 000 − 50 − 5 − 150 = 2 795 мс. Это\nрасчёт без запаса на колебания задержек\n\n----\n\nТребование про 300 мс у 95 процентов запросов относится к чтению состояния\nпоездки -> это зависит от принятия решения от кандидата-водителя. Мы можем\nэто посчитать приблизительно отдельно",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Проверка токена: 10мс\nЧтение водителей и выбор кандидата: 150мс\nТранзакция: 20мс\nУведомление: 200мс\nФормирование ответа: 5мс\n\nИтого: 10 + 150 + 20 + 200 + 5 = 385мс ~ 400мс\n\nЕсли 'уведомление' от водителя не пришло за 500мс, то итог: 400мс - 200мс + 500мс = 700мс\n\n----\n\nТребование про подбор за 3 секунды относится ко времени от заказа пассажира до выбора кандидата. В этот бюджет входят передача запроса, ожидание начала обработки, проверка токена, чтение водителей и подбор. Если передача запроса занимает 50 мс, разбор и проверка токена 5 мс, а чтение и подбор 150 мс, на ожидание начала обработки остаётся 3 000 − 50 − 5 − 150 = 2 795 мс. Это расчёт без запаса на колебания задержек\n\n----\n\nТребование про 300 мс у 95 процентов запросов относится к чтению состояния поездки -> это зависит от принятия решения от кандидата-водителя. Мы можем это посчитать приблизительно отдельно",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
