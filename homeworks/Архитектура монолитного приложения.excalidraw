      "created": 1791001372766,
      "link": null,
      "locked": false,
      "text": "Volume Discounts: Автоматические скидки при превышении определенных порогов\nпотребления за месяц.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Volume Discounts: Автоматические скидки при превышении определенных порогов потребления за месяц.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
