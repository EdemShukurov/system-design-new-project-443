      "seed": 987504461,
      "version": 77,
      "versionNonce": 746026294,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793785921234,
      "created": 1791001372764,
      "link": null,
      "locked": false,
      "text": "Поминутный учет: Деньги списываются строго за время нахождения ВМ в\nсостоянии RUNNING.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Поминутный учет: Деньги списываются строго за время нахождения ВМ в состоянии RUNNING.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
