      "link": null,
      "locked": false,
      "text": "Мульти-кошельки: Приоритетное списание сперва с промо-грантов, затем с\nосновного баланса.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Мульти-кошельки: Приоритетное списание сперва с промо-грантов, затем с основного баланса.",
      "autoResize": false,
      "lineHeight": 1.25,
