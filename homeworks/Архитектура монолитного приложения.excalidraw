      "seed": 1830293411,
      "version": 77,
      "versionNonce": 1032088554,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793785921234,
      "created": 1791001372765,
      "link": null,
      "locked": false,
      "text": "Reserved Instances: Оптовая предоплата со скидкой (гарантированные ресурсы,\nсписываются \"минуты\", а не деньги).",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reserved Instances: Оптовая предоплата со скидкой (гарантированные ресурсы, списываются \"минуты\", а не деньги).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "qRgDMpoltYanfQZdRj4i1",
      "type": "text",
      "x": -1085.5555518416477,
      "y": 227.40123799019432,
