      "versionNonce": 1132420726,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793785921234,
      "created": 1791001372765,
      "link": null,
      "locked": false,
      "text": "On-Demand: Базовая поминутная оплата.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "On-Demand: Базовая поминутная оплата.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "RLfZZl3l4wtN865kZIBvv",
      "type": "text",
      "x": -1081.447214439304,
      "y": 167.40123799019432,
      "width": 789.0333251953125,
      "height": 50,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
