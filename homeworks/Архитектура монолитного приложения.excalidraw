      "text": "Account:\n- id\n- name\n- card_ids\n- promo_grant_ids\n- balance_id  ",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Account:\n- id\n- name\n- card_ids\n- promo_grant_ids\n- balance_id  ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Gp5pdWXpV6d1-E3sY1XMV",
      "type": "text",
      "x": 27.860511650853198,
      "y": -647.2406499349689,
      "width": 716.9833374023438,
      "height": 725,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "ao",
      "roundness": null,
      "seed": 613217773,
      "version": 1344,
      "versionNonce": 507140074,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1793785921234,
      "created": 1791002946710,
      "link": null,
      "locked": false,
      "text": "НАГРУЗКА СЕЙЧАС\n\n1000 ВМ -> 1200 (для простоты)\n1000 / 60 сек = 17 RPS\n17 * 60 = 1020 RPH\n1020 * 24 == 25 000 RP сутки\n25 000 * 30 = 75 000 RP месяц\n75 000 * 12 = 900 000 RP в год\n\n\nНАГРУЗКА В БУДУЩЕМ\n\n100 000+ ВМ -> 120,000 (для простоты)\n120,000 / 60 сек = 2000 RPS\n2000 * 60 = 120 000 RPH\n120 000 * 24 = 2 680 000 RP сутки\n2 680 000 * 30 = 80 000 000 RP месяц\n80 000 000 * 12 = 960 000 000 RP в год\n\n\nОБЪЕМ ХРАНИЛИЩА СЕЙЧАС\n\nодно сообщение 0.5 КБ\nза 1 сек: 17 * 0.5 == 10 КБ\nза 1 день = 10 * 60 * 60 * 24 = 14 400 КБ * 60 = 15 МБ * 60 = 100 МБ \nза 1 мес = 100 * 30 = 3000 МБ\nза 1 год = 3000 * 12 = 36 000 МБ = 36 ГБ\n\n",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "НАГРУЗКА СЕЙЧАС\n\n1000 ВМ -> 1200 (для простоты)\n1000 / 60 сек = 17 RPS\n17 * 60 = 1020 RPH\n1020 * 24 == 25 000 RP сутки\n25 000 * 30 = 75 000 RP месяц\n75 000 * 12 = 900 000 RP в год\n\n\nНАГРУЗКА В БУДУЩЕМ\n\n100 000+ ВМ -> 120,000 (для простоты)\n120,000 / 60 сек = 2000 RPS\n2000 * 60 = 120 000 RPH\n120 000 * 24 = 2 680 000 RP сутки\n2 680 000 * 30 = 80 000 000 RP месяц\n80 000 000 * 12 = 960 000 000 RP в год\n\n\nОБЪЕМ ХРАНИЛИЩА СЕЙЧАС\n\nодно сообщение 0.5 КБ\nза 1 сек: 17 * 0.5 == 10 КБ\nза 1 день = 10 * 60 * 60 * 24 = 14 400 КБ * 60 = 15 МБ * 60 = 100 МБ \nза 1 мес = 100 * 30 = 3000 МБ\nза 1 год = 3000 * 12 = 36 000 МБ = 36 ГБ\n\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
