      "updated": 1793785921234,
      "created": 1791001372766,
      "link": null,
      "locked": false,
      "text": "Spot VMs: Динамическое ценообразование на основе свободных мощностей дата-\nцентра (цена меняется).",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Spot VMs: Динамическое ценообразование на основе свободных мощностей дата-центра (цена меняется).",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "NaouOk4x48ral7xYUOg7i",
