      "isDeleted": true,
      "boundElements": [],
      "updated": 1793785921234,
      "created": 1791001372766,
      "link": null,
      "locked": false,
      "text": "Автоматическая блокировка: Остановка ВМ при исчерпании средств\nпользователя.",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Автоматическая блокировка: Остановка ВМ при исчерпании средств пользователя.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "A1F_IfDL3PxOeKIVLtu7k",
      "type": "text",
