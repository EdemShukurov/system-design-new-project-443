    {
      "id": "i8EgQr72rdFOmfBdVDJ0a",
      "type": "text",
      "x": -211.13533752585147,
      "y": -155.58188811824175,
      "width": 178.73333740234375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "am",
      "roundness": null,
      "seed": 1975088995,
      "version": 294,
      "versionNonce": 750301814,
      "isDeleted": true,
