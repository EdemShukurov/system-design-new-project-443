    {
      "id": "QQGEKrR10GIovBTdKDjSF",
      "type": "text",
      "x": -4740.653361543251,
      "y": 1288.1292146884748,
      "width": 774.8666381835938,
      "height": 350,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
